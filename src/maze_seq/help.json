{
  "title": "Maze",
  "children": [
    {
      "title": "Overview",
      "lines": [
        "Dual generative",
        "sequencer, Moog",
        "Labyrinth style.",
        "",
        "Two 8-step seqs",
        "sync to the Move",
        "clock. Pads set the",
        "key and transpose."
      ]
    },
    {
      "title": "Step Buttons",
      "lines": [
        "16 step buttons =",
        "the two sequencers.",
        "1-8: Seq1 red bit",
        "9-16: Seq2 blue bit",
        "Play head = yellow.",
        "Press to flip a bit."
      ]
    },
    {
      "title": "Pads",
      "lines": [
        "Top 3 rows = scale",
        "keyboard. Middle row",
        "col 1 = root.",
        "Press to transpose",
        "up or down a scale",
        "degree. +/- octave.",
        "",
        "Bottom row: seq",
        "advance and length."
      ]
    },
    {
      "title": "Knobs",
      "children": [
        {
          "title": "Seq Ctrl T1",
          "lines": [
            "K1 Seq1 Corrupt",
            "K2 Seq1 Range",
            "K3 Seq1 Length",
            "K4 Trig Mix",
            "K5 Seq2 Corrupt",
            "K6 Seq2 Range",
            "K7 Seq2 Length",
            "K8 Reset Both:",
            " both seqs to step 1",
            " every 1/2/4/8 bars",
            " (Off to disable)"
          ]
        },
        {
          "title": "Global T2",
          "lines": [
            "K1 Scale",
            "K2 Key",
            "K3 Note Rate",
            "K4 Note Length",
            "K5 Seq1 Channel",
            "K6 Seq2 Channel"
          ]
        }
      ]
    },
    {
      "title": "Transport",
      "lines": [
        "Runs on the Move",
        "clock: press Play.",
        "Back hides but keeps",
        "playing.",
        "Shift+Back exits.",
        "Patterns are saved",
        "and restored."
      ]
    }
  ]
}
